# ============================================================
# APPLICATION
# ============================================================

APP_NAME="AI Streaming Chat Server"
APP_ENV=development
DEBUG=true

# ============================================================
# CHAT CONFIGURATION
# ============================================================

CHAT_MAX_OUTPUT_TOKENS=512
CHAT_CONTEXT_TOKEN_BUDGET=4000
CHAT_SYSTEM_PROMPT="You are a helpful assistant."
STREAM_CHUNK_DELAY=0.0

# ============================================================
# LLM PROVIDER
# ============================================================

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ============================================================
# DATABASE
# ============================================================

DATABASE_URL=postgresql+asyncpg://<username>:<password>@localhost:5432/<your-db-name>

TEST_DATABASE_URL=postgresql+asyncpg://<username>:<password>@localhost:5432/<your-test-db-name>

POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=streaming_db

# ============================================================
# APPLICATION URL
# ============================================================

BACKEND_URL=http://localhost:8000

# ============================================================
# AUTHENTICATION: JWT
# ============================================================

# Generate using: openssl rand -hex 32
JWT_SECRET_KEY=

JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# AUTHENTICATION: EMAIL TOKENS
# ============================================================

EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440

PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# ============================================================
# EMAIL DELIVERY: RESEND
# ============================================================

RESEND_API_KEY=

# Development/testing sender.
# Replace with an address on your verified domain for production.

RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME="AI Streaming Chat"

RESEND_TIMEOUT_SECONDS=10.0
