APP_NAME=AI Streaming Chat Server
APP_ENV=development
DEBUG=true

CHAT_MAX_OUTPUT_TOKENS=512
CHAT_CONTEXT_TOKEN_BUDGET=4000
CHAT_SYSTEM_PROMPT=You are a helpful assistant.

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

DATABASE_URL=postgresql+asyncpg://<username>:<password>@localhost:5432/<your-db-name>
TEST_DATABASE_URL=postgresql+asyncpg://<username>:<password>@localhost:5432/<your-test-db-name>

BACKEND_URL=http://localhost:8000

POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=streaming_db
